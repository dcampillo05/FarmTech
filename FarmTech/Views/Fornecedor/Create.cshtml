@model FornecedorModel

@{
    ViewData["Title"] = "Cadastrar Fornecedor";
}

<div class="text-center">

    <h1 class="display-4">Cadastrar Fornecedor</h1>

</div>

<form asp-controller="Fornecedor" asp-action="Create" method="post">
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" asp-for="Name" class="form-control" placeholder="Digite o nome do Fornecedor">
        @Html.ValidationMessageFor(x => x.Name)
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <input type="email" asp-for="Email" class="form-control" placeholder="Digite o e-mail do Fornecedor">
        @Html.ValidationMessageFor(x => x.Email)
    </div>

    <div class="form-group">
        <label for="nome">CNPJ</label>
        <input type="text" asp-for="Cnpj" class="form-control" placeholder="Digite o CNPJ do Fornecedor">
        @Html.ValidationMessageFor(x => x.Cnpj)
    </div>

    <div class="form-group">
        <label for="nome">Numero</label>
        <input type="text" asp-for="Numero" class="form-control" placeholder="Digite o numero do Fornecedor">
        @Html.ValidationMessageFor(x => x.Numero)
    </div>
   
    <button type="submit" class="btn btn-primary mt-2">Adicionar</button>
    <a class="btn btn-secondary mt-2" asp-controller="Fornecedor" asp-action="Index" role="button">Voltar</a>
</form>